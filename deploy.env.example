# Copy this file to .env.deploy and replace every example value before deployment.
# Generate the database password with: openssl rand -hex 32
POSTGRES_DB=portfolio_journal
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace_with_64_hex_characters

# Used only when bootstrapping a completely empty database.
WORKSPACE_EMAIL=owner@example.com

# Exact Tailscale login allowed to use this private instance.
TAILSCALE_ALLOWED_LOGIN=owner@example.com

# Exact HTTPS URL printed by `tailscale serve 3000`, without a trailing path.
APP_ORIGIN=https://portfolio.example-tailnet.ts.net
APP_PORT=3000

# Absolute directory outside this Git repository.
BACKUP_ROOT=/srv/portfolio-journal-backups
