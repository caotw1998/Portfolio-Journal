{
  "name": "fund-research-desk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "bash script/run-integration-tests.sh",
    "test:e2e": "playwright test",
    "db:export:data": "node script/export-dev-database.js",
    "db:import:data": "node script/import-dev-database.js",
    "db:bootstrap": "node script/bootstrap-workspace.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "deploy:init": "node script/init-private-deployment.js",
    "deploy:check": "node script/deploy-check.js",
    "deploy:backup": "bash script/docker-postgres-backup.sh",
    "deploy:restore": "bash script/docker-postgres-restore.sh",
    "deploy:verify": "bash script/verify-private-deployment.sh",
    "release:check": "bash script/check-public-release.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.0",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "vite": "7.3.5"
    }
  }
}
